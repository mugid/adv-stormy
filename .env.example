DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
BETTER_AUTH_SECRET="generate-a-random-secret-here"
BETTER_AUTH_URL="http://localhost:3000"
ANTHROPIC_API_KEY="sk-ant-..."
NEXT_PUBLIC_WS_URL="ws://localhost:1234"
# Yjs WebSocket server (pnpm dev:ws) reads HOST and PORT — default script uses 0.0.0.0:1234

# Higgsfield (https://docs.higgsfield.ai/how-to/introduction)
HIGGSFIELD_API_KEY="your-api-key"
HIGGSFIELD_API_SECRET="your-api-secret"
# Optional defaults — see https://docs.higgsfield.ai/guides/images.md and guides/video.md
HIGGSFIELD_IMAGE_MODEL="higgsfield-ai/soul/standard"
HIGGSFIELD_VIDEO_MODEL="higgsfield-ai/dop/standard"
# Optional: public site URL if you need absolute links client-side
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ImageKit — canvas image persistence (Neon JSON is not suited for large base64 blobs)
# Dashboard: https://imagekit.io/dashboard/developer/api-keys
IMAGEKIT_PRIVATE_KEY="private_..."
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY="public_..."
# e.g. https://ik.imagekit.io/your_imagekit_id
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/..."
